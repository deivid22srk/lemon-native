<?xml version="1.0" encoding="utf-8"?>
<!-- Dark mode: the reference design — Lemon surfaces (deep olive-charcoal), the lemon yellow primary, the leaf green support. Contrast ratios name the pair each color is drawn in (see values/colors.xml) -->
<resources>
    <color name="bn_bg">#FF0C0D09</color>            <!-- the screen (text on bg 17.6:1, secondary text on bg 8.5:1) -->
    <color name="bn_card">#FF14160F</color>          <!-- cards, dialogs, sheets (text on card 16.5:1, secondary text on card 7.9:1) -->
    <color name="bn_card_stroke">#FF3A3E2B</color>   <!-- hairline card edge, dividers, progress track -->
    <color name="bn_surface3">#FF262A1A</color>      <!-- deep tonal surface: pressed tiles, slots, table stripes (informational) -->
    <color name="bn_tint">#FF1C1F14</color>          <!-- tonal chips, icon tiles (text on tint 15.1:1, secondary text 7.3:1, accent 14.6:1) -->
    <color name="bn_accent">#FFFFE74A</color>        <!-- primary accent: fills, focus ring, links, quiet buttons (15.6:1 on bg, 14.6:1 on card, 10.2:1 on accent_tint, 8.8:1 vs stroke) -->
    <color name="bn_on_accent">#FF1A1700</color>     <!-- label on accent fill (14.4:1) -->
    <color name="bn_accent_tint">#FF3A3300</color>   <!-- tonal accent container: selected segments, chips (accent on it 10.2:1) -->
    <color name="bn_hero_end">#FF485D24</color>      <!-- the hero gradient's far end: the leaf support's hue at the container depth (body text on it 6.6:1) -->
    <color name="bn_secondary">#FFA8E04A</color>     <!-- leaf green support: secondary chips, the hero gradient's leaf end's hue source (12.5:1 on bg, 11.7:1 on card) -->
    <color name="bn_accent_warm">#FFFF9F43</color>   <!-- citric warm accent: update-available chips, warm highlights (8.9:1 on card) -->
    <color name="bn_banana">#FFFFE74A</color>        <!-- brand accent, brand moments only (the header badge's glyph, the empty state): never a button fill -->
    <color name="bn_banana_deep">#FFE8D11E</color>   <!-- pressed brand accent -->
    <color name="bn_on_banana">#FF1A1700</color>     <!-- text on the brand accent (14.4:1 on banana, 11.6:1 on banana_deep) -->
    <color name="bn_text">#FFF3F4EA</color>          <!-- body text (16.5:1 on card, 17.6:1 on bg, 15.1:1 on tint) -->
    <color name="bn_text_2">#FFA9AD98</color>        <!-- secondary text (7.9:1 on card, 8.5:1 on bg, 7.3:1 on tint) -->
    <color name="bn_leaf">#FF5BE38A</color>          <!-- success text, bn_ok shares it (11.1:1 on card, 8.6:1 on ok_tint) -->
    <color name="bn_badge">#FF3F6A00</color>         <!-- the header badge's circle stays deep leaf in both modes (the badge glyph, ic_lemon's lemon, reads on it: 5.1:1, LEMON: rebrand; see values/colors.xml) -->
    <color name="bn_on_leaf">#FF0B2410</color>       <!-- text on leaf green (10.1:1) -->
    <color name="bn_danger">#FFFF6B6B</color>        <!-- error text, danger button label (6.6:1 on card, 5.8:1 on danger_tint, 4.8:1 on warn_tint) -->
    <color name="bn_danger_tint">#FF3B1616</color>   <!-- danger button container (text on it 5.8:1) -->
    <color name="bn_warn_tint">#FF3D2C12</color>     <!-- warning container, warning chips (warning text on it 8.4:1) -->
    <color name="bn_ok">#FF5BE38A</color>            <!-- success text: shares the leaf green (11.1:1 on card, 8.6:1 on ok_tint) -->
    <color name="bn_warn">#FFFFC169</color>          <!-- warning text (11.4:1 on card, 8.4:1 on warn_tint) -->
    <color name="bn_ok_tint">#FF173112</color>       <!-- success container (text on it 8.6:1); its first call site is StatusChip.OK, as in the light mode -->
    <color name="bn_control_ripple">#33F3F4EA</color><!-- theme widget highlight/ripple (20% text, Ui.ripple) -->

    <!-- The library's building-cover progress strip track (Library.strip): the dark mode's bn_bg at 70% alpha over cover art — the light mode derives its value the same way from its bn_bg (see values/colors.xml) -->
    <color name="bn_track">#B30C0D09</color>
</resources>
