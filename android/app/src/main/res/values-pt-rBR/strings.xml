    <string name="lemon_setup_access_title">Permitir acesso a arquivos</string>
    <string name="lemon_setup_access_body">O app lê o dump do seu jogo onde ele está no armazenamento e guarda os saves na pasta dele. Um arquivo .nup funciona sem isso; uma pasta de dump também pode ser copiada para dentro do app.</string>
