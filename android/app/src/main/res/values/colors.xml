<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The icon's background (deep green) behind the banana -->
    <color name="ic_launcher_background">#FF1E5B3A</color>

    <!-- The launcher's palette (Ui.java, themes.xml): "Slate & Signal" — cool slate surfaces told apart by fill and hairline edge, one Signal blue for every primary
         action, focus ring and selected state, and the harvest amber kept for brand moments (the header badge's glyph, the empty state). values-night has the dark
         reference set. Contrast ratios (WCAG 2.1, checked by script; text needs 4.5:1, UI shapes and icons 3:1) name the pair each color is drawn in -->
    <color name="bn_bg">#FFF2F4F8</color>            <!-- the screen (text on bg 15.1:1, secondary text on bg 5.7:1) -->
    <color name="bn_card">#FFFFFFFF</color>          <!-- cards, dialogs, sheets (text on card 16.6:1, secondary text 6.3:1, accent 6.0:1) -->
    <color name="bn_card_stroke">#FFCFD8E3</color>   <!-- hairlines, dividers, progress track -->
    <color name="bn_tint">#FFEBEFF5</color>          <!-- tonal chips, icon tiles (accent on tint 5.2:1) -->
    <color name="bn_accent">#FF0A5FC7</color>        <!-- primary accent: fills, focus ring, links, quiet buttons (5.5:1 on bg, 6.0:1 on card, 5.0:1 on accent_tint, 4.2:1 vs stroke) -->
    <color name="bn_on_accent">#FFFFFFFF</color>     <!-- label on accent fill (6.0:1) -->
    <color name="bn_accent_tint">#FFDFEBF9</color>   <!-- tonal accent container: selected segments, chips -->
    <color name="bn_banana">#FFF7C03A</color>        <!-- secondary accent, brand moments only (the header badge's glyph, the empty state): never a button fill -->
    <color name="bn_banana_deep">#FFD9A02F</color>   <!-- pressed secondary accent -->
    <color name="bn_on_banana">#FF33200A</color>     <!-- text on amber (9.3:1 on banana, 6.7:1 on banana_deep) -->
    <color name="bn_text">#FF171F2B</color>          <!-- body text (16.6:1 on card, 15.1:1 on bg) -->
    <color name="bn_text_2">#FF526175</color>        <!-- secondary text (6.3:1 on card, 5.7:1 on bg) -->
    <color name="bn_leaf">#FF0F7A40</color>          <!-- success text, bn_ok shares it (5.4:1 on card, 4.5:1 on ok_tint) -->
    <color name="bn_badge">#FF1E5B3A</color>         <!-- the header badge's circle: the launcher icon's deep green (ic_launcher_background) in BOTH modes — the badge glyph (ic_banana_happy's #FFD43B banana) reads on it (5.64:1) -->
    <color name="bn_on_leaf">#FFFFFFFF</color>       <!-- text on leaf green (5.4:1) -->
    <color name="bn_danger">#FFB23517</color>        <!-- error text, danger button label (6.2:1 on card, 5.0:1 on danger_tint, 5.0:1 on warn_tint) -->
    <color name="bn_danger_tint">#FFFAE3DB</color>   <!-- danger button container (text on it 5.0:1) -->
    <color name="bn_warn_tint">#FFF6E8B9</color>     <!-- warning container, warning chips (warning text on it 5.2:1) -->
    <color name="bn_ok">#FF0F7A40</color>            <!-- success text: shares the leaf green (5.4:1 on card, 4.5:1 on ok_tint) -->
    <color name="bn_warn">#FF8A5200</color>          <!-- warning text (6.4:1 on card, 5.2:1 on warn_tint) -->
    <color name="bn_ok_tint">#FFDFEFE3</color>       <!-- success container (text on it 4.5:1); declared for the first success surface that needs it — the Readiness
                                                          check's pass rows stay on the card, so the fail and warn rows stand out -->
    <color name="bn_control_ripple">#33171F2B</color><!-- theme widget highlight/ripple (20% ink, Ui.ripple) -->

    <!-- Overlay-stable colors: the in-game/companion surfaces render over the game in BOTH modes, so they carry the dark slate set here, with no values-night override -->
    <color name="bn_overlay_scrim">#66000000</color>  <!-- overlay-stable: renders over the game in both modes — 40% black over the running game -->
    <color name="bn_overlay_card">#F0141A24</color>   <!-- overlay-stable: renders over the game in both modes — the overlay's slate card (text on it 14.8:1, secondary text 7.3:1) -->
    <color name="bn_overlay_stroke">#FF2B3543</color> <!-- overlay-stable: renders over the game in both modes — hairline edges and empty slots on the card (informational) -->
    <color name="bn_overlay_text">#FFE8EDF4</color>   <!-- overlay-stable: renders over the game in both modes (14.8:1 on the card, 17.9:1 on black) -->
    <color name="bn_overlay_text_2">#FF9DA9B8</color> <!-- overlay-stable: renders over the game in both modes — secondary text (7.3:1 on the card) -->
    <color name="bn_overlay_accent">#FF58A6F5</color> <!-- overlay-stable: renders over the game in both modes — the same Signal blue: selection edges, values, focus (6.8:1 on the card) -->
    <color name="bn_overlay_ok">#FF67C795</color>     <!-- overlay-stable: renders over the game in both modes — success (8.5:1 on the card) -->
    <color name="bn_overlay_warn">#FFF2C341</color>  <!-- overlay-stable: renders over the game in both modes — the throttle trio's middle (Hud.LEVEL, HistogramSpan, Overlay.DOT): the same amber as bn_warn, kept here because the overlay carries no values-night override (10.5:1 on the overlay card, 12.7:1 on black) -->
    <color name="bn_overlay_danger">#FFFF8A76</color> <!-- overlay-stable: renders over the game in both modes — danger (7.6:1 on the card) -->

    <!-- The library's building-cover progress strip track (Library.strip): the strip runs over cover art, so its track carries alpha like the in-code composite it
         replaces (the mode's slate at 70 % alpha) — a resource so no helper holds the hex, with the night value in values-night -->
    <color name="bn_track">#B3CFD8E3</color>
</resources>
