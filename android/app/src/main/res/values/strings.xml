    <string name="lemon_setup_welcome_title">Welcome to Lemon Native</string>
    <string name="lemon_setup_welcome_body">Lemon Native runs a dump of a Switch game you own as an app on this phone: build it once, then play. This setup walks you through the files it needs.</string>
    <string name="lemon_setup_welcome_needs">You will need</string>
