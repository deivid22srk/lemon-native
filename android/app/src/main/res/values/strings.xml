    <string name="lemon_setup_access_not_allowed">Not allowed yet</string>
    <string name="lemon_setup_access_allow">Allow in Android settings</string>
    <string name="lemon_setup_access_note">You can continue without it — the app asks again when a build needs it.</string>
    <string name="lemon_setup_folder_title">Your game folder</string>
    <string name="lemon_setup_folder_body">Pick the folder that holds your game dumps. Every NSP, XCI, .nup and dump folder inside it shows on Home.</string>
